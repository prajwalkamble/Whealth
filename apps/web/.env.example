# WHealthOS — web application environment
#
# Copy to .env and fill in. .env is gitignored and must stay that way.
# database/.env is a symlink to this file, so credentials exist in one place.

# --- Application ---------------------------------------------------------
# Calendar used for every "this month" figure. Defaults to Asia/Kolkata.
APP_TIME_ZONE="Asia/Kolkata"

# --- Authentication (Clerk) ----------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_..."
CLERK_SECRET_KEY="sk_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- Database (PostgreSQL) -----------------------------------------------
# DATABASE_URL: the request path. Should be the restricted application role,
#   which is subject to row-level security.
# DIRECT_URL: migrations and background jobs. Owner role.
# Percent-encode any special characters in the password.
DATABASE_URL="postgresql://user:password@host:5432/whealth?schema=public"
DIRECT_URL="postgresql://owner:password@host:5432/whealth?schema=public"

# --- Email (Resend) ------------------------------------------------------
RESEND_API_KEY="re_..."
# Sender on a domain verified in Resend. Unset means nothing can be
# delivered: the shared test sender only reaches the Resend account owner.
RESEND_FROM_EMAIL="WHealthOS <reports@yourdomain.com>"
# Where the in-app feedback widget delivers. Unset and the widget refuses
# rather than pretending a message was sent.
FEEDBACK_EMAIL="you@yourdomain.com"

# --- Security (Arcjet) ---------------------------------------------------
ARCJET_KEY="ajkey_..."

# --- Background jobs (Inngest) -------------------------------------------
INNGEST_SIGNING_KEY="signkey-prod-..."
INNGEST_EVENT_KEY=""

# --- AI ------------------------------------------------------------------
# TEMPORARY. The hosted model call is being replaced by a self-hosted model
# (see docs/architecture/ai.md and ADR-004). No new hosted-LLM providers.
GEMINI_API_KEY="..."
#
# FUTURE — the local model's serving endpoint. Not yet used.
# WHEALTHOS_LLM_URL="http://localhost:8080"

# --- Development ---------------------------------------------------------
# Optional. The database suites create and delete rows, so they run only
# against a local database unless ALLOW_REMOTE_TEST_DB=1 is set deliberately.
# Put these in .env.test, never here.
# DATABASE_URL / DIRECT_URL pointing at a disposable local database.
