# WHealthOS — web application environment
#
# Copy to .env and fill in. .env is gitignored and must stay that way.
# database/.env is a symlink to this file, so credentials exist in one place.

# --- Application ---------------------------------------------------------
# Calendar used for every "this month" figure. Defaults to Asia/Kolkata.
APP_TIME_ZONE="Asia/Kolkata"

# --- Authentication (Clerk) ----------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_..."
CLERK_SECRET_KEY="sk_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# Signing secret for the Clerk webhook, from the endpoint's page in the Clerk
# dashboard. Subscribe that endpoint to user.deleted and point it at
# /api/webhooks/clerk. Without this the endpoint answers 500 and Clerk retries,
# which is deliberate: a deletion that is silently dropped leaves someone's
# financial records behind after they asked for them to be gone.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# --- Database (PostgreSQL) -----------------------------------------------
# These two are not interchangeable, and getting them the wrong way round
# fails silently. DATABASE_URL must NOT be the superuser (`postgres` on a
# managed instance has BYPASSRLS) and must not belong to whealth_jobs: either
# one skips every row-level security policy for ordinary requests, nothing
# errors, and no test catches it. lib/prisma.js asks the database directly on
# the first tenant query and logs loudly if it finds one of them.
#
# DATABASE_URL: the request path. Should be the restricted application role,
#   which is subject to row-level security.
# DIRECT_URL: migrations and background jobs. Owner role.
# Percent-encode any special characters in the password.
DATABASE_URL="postgresql://user:password@host:5432/whealth?schema=public"
DIRECT_URL="postgresql://owner:password@host:5432/whealth?schema=public"

# --- Email (Resend) ------------------------------------------------------
# Outbound and inbound both go through Resend. One client, in lib/email/.
RESEND_API_KEY="re_..."

# Sender, on a domain verified in Resend. Required in production: unset and
# every send is refused rather than attempted, because an unverified sender is
# rejected for every recipient.
RESEND_FROM_EMAIL="WHealthOS <hello@yourdomain.com>"

# Optional. Default Reply-To for automated mail, when replies should reach a
# different mailbox from the sender. Unset means no Reply-To header is added.
# Only set it to an address that someone actually reads.
RESEND_REPLY_TO_EMAIL=""

# Where the in-app feedback widget delivers, and where a verified inbound
# email is forwarded. Unset and the widget refuses rather than pretending a
# message was sent.
FEEDBACK_EMAIL="you@yourdomain.com"

# Signing secret for the Resend webhook, from the webhook's page in the Resend
# dashboard. Required for inbound: without it /api/webhooks/resend refuses
# every request rather than trusting one. Never a value starting with "re_" --
# that is the API key, not the webhook secret.
RESEND_WEBHOOK_SECRET="whsec_..."

# --- Security (Arcjet) ---------------------------------------------------
ARCJET_KEY="ajkey_..."

# --- Background jobs (Inngest) -------------------------------------------
INNGEST_SIGNING_KEY="signkey-prod-..."
INNGEST_EVENT_KEY=""

# --- AI ------------------------------------------------------------------
# TEMPORARY. The hosted model call is being replaced by a self-hosted model
# (see docs/architecture/ai.md and ADR-004). No new hosted-LLM providers.
GEMINI_API_KEY="..."
#
# FUTURE — the local model's serving endpoint. Not yet used.
# WHEALTHOS_LLM_URL="http://localhost:8080"

# --- Development ---------------------------------------------------------
# Optional. The database suites create and delete rows, so they run only
# against a local database unless ALLOW_REMOTE_TEST_DB=1 is set deliberately.
# Put these in .env.test, never here.
# DATABASE_URL / DIRECT_URL pointing at a disposable local database.
