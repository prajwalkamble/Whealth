// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // Generated to a fixed path rather than into node_modules.
  //
  // Under pnpm the client lands inside a hashed .pnpm/ directory, and Next's
  // bundler then cannot find the query engine binary that has to sit beside
  // it -- the production build fails at "Collecting page data" with
  // "could not locate the Query Engine". A stable directory the app can
  // resolve normally avoids the whole problem.
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(uuid())
  clerkUserId  String        @unique // clerk user id
  // Optional: Clerk allows sign-in without an email address (phone, some
  // OAuth providers). Emails are simply not sent to users without one.
  email        String?       @unique
  name         String
  imageUrl     String
  transactions Transaction[]
  accounts     Account[]
  budgets      Budget[]
  cards        Card[]
  goals        Goal[]
  contributions GoalContribution[]
  rating       Rating?
  // Light / dark / system, chosen in the app and kept on the account so the
  // choice follows the user to another browser or device.
  // Appearance settings from lib/preferences.js (theme colour, chart colours,
  // fonts, scale, radius, colour schema, layout, sidebar). One column rather
  // than ten, since they are only ever read and written together.
  preferences  Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

model Account {
  id           String        @id @default(uuid())
  name         String
  type         AccountType
  balance      Decimal       @default(0) // will ask inital balance while creating an account
  isDefault    Boolean       @default(false)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  cards        Card[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  // Supports the accounts_isolation RLS predicate and the default-account lookup
  @@index([userId, isDefault], map: "accounts_user_default_idx")
  @@map("accounts")
}

enum AccountType {
  CURRENT
  SAVINGS
}

model Transaction {
  id                String             @id @default(uuid())
  type              TransactionType
  amount            Decimal
  description       String?
  date              DateTime
  category          String
  receiptUrl        String?
  isRecurring       Boolean            @default(false)
  recurringInterval RecurringInterval? // Only used if isRecurring is true
  nextRecurringDate DateTime? // Next date for recurring transaction
  lastProcessed     DateTime? // Last time this recurring transaction was processed
  status            TransactionStatus  @default(COMPLETED)
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  account           Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId])
  @@index([accountId])
  // Support the transactions_isolation RLS predicate on the hot read paths
  @@index([userId, date(sort: Desc)], map: "transactions_user_date_idx")
  @@index([userId, accountId], map: "transactions_user_account_idx")
  @@map("transactions")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurringInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

// A planned spending limit.
//
// Migrated additively from one-budget-per-user: `category` is null on the
// overall monthly budget -- the single row that already existed and that the
// dashboard and the alert cron still read -- and set on a per-category budget.
// The old @unique on userId is gone, replaced by a pair of constraints
// declared in the migration: one budget per category, and at most one overall.
model Budget {
  id            String    @id @default(uuid())
  amount        Decimal
  // Null means the overall monthly budget. Otherwise a transaction category.
  category      String?
  lastAlertSent DateTime? // Track when the last alert was sent
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, category], map: "budgets_user_category_key")
  @@index([userId])
  @@map("budgets")
}

// A card is reference metadata, not an instrument. It records what a person
// needs to recognise the card and track its limits -- never anything that
// could be used to transact. There is deliberately no column for a full card
// number, a CVV or a PIN, and `last4` is a label rather than an identifier.
//
// `accountId` is optional: a card may be settled from one of the user's
// accounts, or recorded on its own.
model Card {
  id          String      @id @default(uuid())
  name        String
  issuer      String
  network     CardNetwork
  type        CardType
  // Four digits, stored as text so a leading zero survives.
  last4       String
  expiryMonth Int
  expiryYear  Int
  // Credit cards only; null on a debit card, which has no limit of its own.
  creditLimit Decimal?
  // Day of the month, 1-31. Null when the user has not recorded it.
  billingDay  Int?
  dueDay      Int?
  status      CardStatus  @default(ACTIVE)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String?
  // SetNull rather than Cascade: deleting an account should not silently
  // delete the record of a card that settled from it.
  account     Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  // Supports the cards_isolation RLS predicate on the list page's read path
  @@index([userId, status], map: "cards_user_status_idx")
  @@index([accountId])
  @@map("cards")
}

enum CardNetwork {
  VISA
  MASTERCARD
  RUPAY
  AMEX
  DINERS
  OTHER
}

enum CardType {
  CREDIT
  DEBIT
}

enum CardStatus {
  ACTIVE
  ARCHIVED
}

// A financial objective and the money put toward it.
//
// There is no currentAmount column on purpose. Progress is the sum of the
// contributions below, derived on read the same way budget spend is: a total
// stored alongside the target is a second source of truth that drifts the
// moment a contribution is corrected or removed.
model Goal {
  id           String             @id @default(uuid())
  name         String
  description  String?
  targetAmount Decimal
  // Optional: not every objective has a deadline.
  targetDate   DateTime?
  status       GoalStatus         @default(ACTIVE)
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([userId])
  // Supports the goals_isolation RLS predicate on the list page's read path
  @@index([userId, status], map: "goals_user_status_idx")
  @@map("goals")
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

// One payment toward a goal. Carries userId of its own so the RLS predicate
// is a column check rather than a join through the goal.
model GoalContribution {
  id        String   @id @default(uuid())
  amount    Decimal
  date      DateTime
  note      String?
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([goalId])
  @@index([userId])
  @@map("goal_contributions")
}

// One rating per user, which they can change. Averaged for the landing page.
model Rating {
  id        String   @id @default(uuid())
  score     Int // 1-5, enforced by a CHECK constraint in the migration
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ratings")
}

// One row per 5-minute slot in which the uptime heartbeat succeeded. A slot
// with no row is downtime: the app or the database could not record it.
model UptimeCheck {
  slot DateTime @id

  @@map("uptime_checks")
}

// Email received at a WHealthOS address, via the Resend inbound webhook.
//
// Not tenant data: it arrives from anyone, to a support address, and the From
// header of an email is trivially forged -- so it is deliberately NOT linked
// to a User. Treating a claimed sender as an identity would let anyone address
// a message "as" a WHealthOS user. Row-level security therefore restricts this
// table to the job runner rather than to a tenant.
//
// The HTML body is deliberately not stored. Only the plain-text part is kept:
// nothing then exists that could be rendered into a page later by mistake, and
// an inbox of raw HTML from strangers is a liability with no current use.
model InboundEmail {
  id String @id @default(uuid())

  // The webhook delivery's own identifier, used for idempotency. Resend retries
  // a delivery it did not get a 2xx for, so the same email can arrive several
  // times; unique means the second insert loses rather than duplicating.
  eventId String @unique

  // The email's own Message-ID header, where it has one. Useful for threading
  // and for recognising the same message delivered through another route.
  messageId String?

  fromAddress String
  toAddress   String
  subject     String?
  // Plain text only, truncated before storage.
  text        String?
  // Metadata only: attachments are counted, never downloaded or stored.
  attachments Int    @default(0)

  status      InboundEmailStatus @default(RECEIVED)
  forwardedAt DateTime?
  // Why forwarding failed, when it did. Never the message body.
  error       String?

  receivedAt DateTime
  createdAt  DateTime @default(now())

  @@index([receivedAt(sort: Desc)])
  @@index([status])
  @@map("inbound_emails")
}

enum InboundEmailStatus {
  RECEIVED
  FORWARDED
  FAILED
}
